[app]
title = Qureo Premium
package.name = qureopremium
package.domain = org.qureo
source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas,html,js,css,txt
version = 1.0
requirements = python3,flask,requests
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,ACCESS_NETWORK_STATE,FOREGROUND_SERVICE
android.archs = arm64-v8a
p4a.bootstrap = webview
android.api = 33
android.minapi = 21
android.ndk_api = 21
android.accept_sdk_license = True
android.entrypoint = main.py
android.wakelock = True
